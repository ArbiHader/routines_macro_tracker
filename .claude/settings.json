{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Task",
      "Agent",
      "Read",
      "Write",
      "Edit",
      "Grep",
      "Glob",
      "WebSearch",
      "WebFetch",
      "Artifact",
      "Artifact(publish)",
      "Artifact(publish:*)",
      "mcp__Gmail__send_message",
      "mcp__Gmail__get_message",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(python3 scripts/render_report.py:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)"
    ]
  }
}
